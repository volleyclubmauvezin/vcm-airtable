# Copie ce fichier en ".env" (ne jamais committer le vrai .env) et renseigne les deux valeurs.

# Personal Access Token généré dans le compte Airtable du club (volleyclubmauvezin@gmail.com),
# Paramètres du compte > Developer hub > Personal access tokens.
# Scopes nécessaires : data.records:read, data.records:write, schema.bases:read, schema.bases:write
# Accès : la base VCM créée à la main (voir README.md).
AIRTABLE_TOKEN=

# Identifiant de la base Airtable (visible dans l'URL de la base : airtable.com/appXXXXXXXXXXXXXX/...)
AIRTABLE_BASE_ID=
